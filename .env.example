PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=ews_db
DATABASE_URL=postgresql://postgres:root@localhost:5432/ews_db

# Security & Tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Smart University Integrations
INTEGRATION_API_KEY=your_integration_api_key
AI_ADVISOR_URL=https://ai-advisor.internal.campus/api
AI_ADVISOR_HMAC_SECRET=your_hmac_secret

# Notifications
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=your_whatsapp_token

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=ews-noreply@dinamika.ac.id
